{
  "name": "designmap",
  "version": "0.0.0",
  "private": true,
  "description": "Map your mobile app's design system from its code: colors, type, spacing and components, for SwiftUI, Jetpack Compose and React Native.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "designmap": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p figma-plugin/tsconfig.json && tsc -p figma-plugin/tsconfig.ui.json",
    "test": "vitest run",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm build:plugin",
    "build:plugin": "node figma-plugin/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@figma/plugin-typings": "1.142.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
